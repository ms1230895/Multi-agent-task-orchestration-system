# Main model (confirmed tool calling on 2026-10-16)
OLLAMA_MODEL=gpt-oss:120b-cloud
# Second model for comparison runs
OLLAMA_MODEL_ALT=gemma4:31b-cloud
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_S=120
MAX_RETRIES=2
MAX_REPLANS=1
MAX_TOOL_ITERATIONS=5
TOOL_RETRY_ATTEMPTS=2
ENABLE_VALIDATION=true
ENABLE_RETRY=true
# Streamlit app: "true" shows the Run page (starts real LLM runs). Default false = replay only.
UI_ALLOW_LIVE_RUNS=false
